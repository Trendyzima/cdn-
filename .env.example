# Private Backend origin; Backend self-hosted Compose must create testagram-platform first.
TESTAGRAM_BACKEND_INTERNAL_URL=http://testagram-backend-api:8082
# Must exactly match CDN_ORIGIN_AUTH_TOKEN in the Backend .env. Generate independently.
ORIGIN_AUTH_TOKEN=REPLACE_WITH_SHARED_RANDOM_32_BYTE_TOKEN
NODE_ID=local-edge
ALLOWED_ORIGINS=https://testagram.site,https://www.testagram.site
