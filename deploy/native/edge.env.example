LISTEN_ADDR=:8080
CACHE_DIR=/var/lib/testagram-edge/cache
NODE_ID=edge-ke-01

# Authenticated media origin(s)
ORIGIN_URL=
ORIGIN_URLS=
ORIGIN_AUTH_TOKEN=

# Optional shield/edge pools
SHIELD_URLS=
EDGE_URLS=

# Signed playback/purge
PLAYBACK_SECRET=
PURGE_TOKEN=

# HLS performance
MANIFEST_TTL=2s
SEGMENT_TTL=60s
STALE_IF_ERROR=120s
SEGMENT_STALE_FOR=2m
MAX_SEGMENT_BYTES=16777216
MAX_CACHE_BYTES=8589934592

# Upstream connection reuse
ORIGIN_TIMEOUT=8s
MAX_IDLE_CONNS=8192
MAX_IDLE_CONNS_PER_HOST=2048
MAX_CONNS_PER_HOST=0

# Abuse protection
RATE_LIMIT_PER_MIN=6000
RATE_LIMIT_BURST=1200
TV_MAX_REDIRECTS=4

# Production CORS allow-list
ALLOWED_ORIGINS=https://testagram.site
