FROM scratch

# Artifact extraction does not reliably preserve executable bits.

COPY --chmod=0555 container/testagram-edge /testagram-edge
COPY --chmod=0555 container/healthcheck /healthcheck
COPY container/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chown=65532:65532 container/cache/keep.txt /cache/.keep

USER 65532:65532
ENV LISTEN_ADDR=:8080
ENV CACHE_DIR=/cache
ENV HEALTHCHECK_URL=http://127.0.0.1:8080/readyz
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --retries=6 --start-period=10s CMD ["/healthcheck"]
ENTRYPOINT ["/testagram-edge"]
